generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователь Telegram
model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  username   String?
  firstName  String?
  lastName   String?
  photoUrl   String?
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())

  participations     Participation[]
  personalChallenges PersonalChallenge[]
  weights            WeightEntry[]
  bodyProfile        UserBodyProfile?
  measurements       BodyMeasurement[]
  workouts           Workout[]
  integrations       Integration[]
  foodEntries        FoodEntry[]
  ingestLogs         IngestLog[]
}

// Челлендж (например «Планка каждый день»). Все настройки редактируются в админке.
model Challenge {
  id                 Int      @id @default(autoincrement())
  key                String   @unique
  /// plank — ежедневная планка с кружками и штрафами; weight — группа для взвешиваний;
  /// fitness — недельная норма тренировок, жизни и личные цели
  kind               String   @default("plank")
  title              String
  description        String   @default("")
  rulesText          String   @default("")
  isActive           Boolean  @default(true)
  timezone           String   @default("Europe/Moscow")
  startDate          DateTime @db.Date
  dailyDeadline      String   @default("23:59") // HH:mm в TZ челленджа
  sickDeadline       String   @default("14:00") // HH:mm в TZ челленджа
  minDurationSec     Int      @default(60)
  fineAmount         Int      @default(500)
  fakeFineMultiplier Int      @default(2)
  chatId             BigInt? // мониторимая группа
  freezeStreakOnSick Boolean  @default(true)
  freezeEveryDays    Int      @default(30) // сколько дней подряд даёт одну заморозку серии (0 = выключено)
  maxFreezes         Int      @default(3) // сколько заморозок можно держать на руках (0 = выключено)
  reportTime         String   @default("00:05") // когда слать отчёт за предыдущий день
  reminderTime       String   @default("21:00") // когда напоминать тем, кто не прислал кружок
  dmReminders        Boolean  @default(true) // слать личные напоминания в ЛС (помимо чата)
  lastChanceTime     String   @default("23:30") // «последний шанс» в ЛС перед дедлайном (пусто = выкл)
  /// Длительность в днях: последний день = startDate + durationDays − 1. null — бессрочный.
  durationDays       Int?
  joinOpen           Boolean  @default(true) // можно ли вступить кнопкой «Участвовать»
  // ---- только для kind=fitness ----
  weeklyWorkouts     Int      @default(3) // обязательных тренировок за 7-дневку от даты старта
  lives              Int      @default(3) // проваленная неделя снимает жизнь, ноль — выбыл
  minWorkoutMin      Int      @default(20) // короче этого тренировка в зачёт недели не идёт
  maxWorkoutsPerDay  Int      @default(1) // сколько тренировок одного дня идёт в зачёт
  weekCloseTime      String   @default("12:00") // итог недели — на следующий день после её конца
  createdAt          DateTime @default(now())

  participations Participation[]
  submissions    Submission[]
  sickDays       SickDay[]
  ledger         LedgerEntry[]
  quotes         MotivationalQuote[]
  reports        DailyReport[]
  freezes        StreakFreeze[]
  weekResults    WeekResult[]
}

// Участие пользователя в челлендже («подтверждение участия»)
model Participation {
  id          Int       @id @default(autoincrement())
  challengeId Int
  userId      Int
  status      String    @default("active") // active | left
  joinedAt    DateTime  @default(now())
  leftAt      DateTime? // когда участника исключили (null, пока он в челлендже)

  challenge         Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions       Submission[]
  sickDays          SickDay[]
  freezes           StreakFreeze[]
  ledger            LedgerEntry[]
  notificationPrefs NotificationPref[]
  goal              ParticipantGoal?
  weekResults       WeekResult[]

  @@unique([challengeId, userId])
}

// Личные настройки уведомлений участника. Пустое поле = «как у челленджа»,
// заданное — перебивает настройку админа.
model NotificationPref {
  id              Int       @id @default(autoincrement())
  participationId Int
  type            String // daily_reminder
  enabled         Boolean? // null = как у челленджа (dmReminders)
  timeHHmm        String? // HH:mm, только :00 и :30; null = как у челленджа (reminderTime)
  lastSentDay     DateTime? @db.Date // защита от повторной отправки в тот же день
  updatedAt       DateTime  @updatedAt

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, type])
}

// Подтверждение планки (видео-кружок)
model Submission {
  id              Int      @id @default(autoincrement())
  challengeId     Int
  participationId Int
  day             DateTime @db.Date // день челленджа в его TZ
  messageId       BigInt?
  videoDuration   Int?
  submittedAt     DateTime @default(now())
  status          String   @default("counted") // counted | late | fake | rejected
  createdAt       DateTime @default(now())

  challenge     Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, day])
}

// Заявка о болезни/травме
model SickDay {
  id              Int      @id @default(autoincrement())
  challengeId     Int
  participationId Int
  day             DateTime @db.Date
  reportedAt      DateTime @default(now())
  status          String   @default("valid") // valid (до дедлайна) | late
  note            String?

  challenge     Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, day])
}

// Заморозка серии: участник тратит заработанную заморозку на пропущенный день,
// чтобы серия не оборвалась. Заработанные заморозки не хранятся — они считаются
// из истории (каждые challenge.freezeEveryDays дней подряд = одна заморозка),
// в базе лежат только потраченные.
model StreakFreeze {
  id              Int      @id @default(autoincrement())
  challengeId     Int
  participationId Int
  day             DateTime @db.Date // какой день заморожен
  earnedDay       DateTime @db.Date // день, за который эта заморозка получена (раньше него применить нельзя)
  createdAt       DateTime @default(now())

  challenge     Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, day])
}

// Реестр банка: банк = SUM(amount) по типам miss|fake|adjustment|spend. amount > 0 пополняет, < 0 списывает.
// payment (оплата участника, «сколько скинул») хранится с положительной суммой, гасит личный долг, но в банк не входит.
model LedgerEntry {
  id              Int       @id @default(autoincrement())
  challengeId     Int
  participationId Int?
  type            String // miss | fake | adjustment | spend | payment
  amount          Int
  day             DateTime? @db.Date
  note            String?
  createdAt       DateTime  @default(now())

  challenge     Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participation Participation? @relation(fields: [participationId], references: [id], onDelete: SetNull)
}

// Мотивационная речь (редактируется в админке)
model MotivationalQuote {
  id          Int       @id @default(autoincrement())
  challengeId Int? // null = глобальная
  text        String
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

// Личный челлендж пользователя (например подтягивания/отжимания), только для себя
model PersonalChallenge {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  unit      String   @default("повторений")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets WorkoutSet[]
}

// Один подход в личном челлендже (день + число повторений)
model WorkoutSet {
  id                  Int      @id @default(autoincrement())
  personalChallengeId Int
  day                 DateTime @db.Date
  reps                Int
  createdAt           DateTime @default(now())

  challenge PersonalChallenge @relation(fields: [personalChallengeId], references: [id], onDelete: Cascade)

  @@index([personalChallengeId, day])
}

// Взвешивание: приходит с телефонного хаба вместе с тренировками (весы пишут вес и состав
// тела в хранилище здоровья) либо вносится вручную. Данные личные: видит только сам пользователь.
model WeightEntry {
  id            Int      @id @default(autoincrement())
  userId        Int
  measuredAt    DateTime // момент взвешивания (приходит от весов)
  day           DateTime @db.Date // день в TZ приложения
  weightKg      Float
  bodyFat       Float? // % жира
  water         Float? // % воды
  muscle        Float? // % мышц
  sourceOwnerId Int? // чей телефон прислал запись (владелец токена), null — ручной ввод
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, measuredAt])
  @@index([userId, day])
}

// Лог отправленных дневных отчётов (идемпотентность)
model DailyReport {
  id          Int      @id @default(autoincrement())
  challengeId Int
  day         DateTime @db.Date
  content     String
  sentAt      DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, day])
}

// ВАЖНО для таблиц ниже: схема накатывается `prisma db push` без миграций, а он отказывается
// вешать уникальный индекс на уже существующую таблицу. Все @unique задаются в момент
// создания таблицы; позже добавлять можно только nullable-поля, поля с @default и @@index.

// Антропометрия человека. Привязана к пользователю, а не к участию: рост и год рождения
// переживают челлендж и нужны для расчёта базового обмена.
model UserBodyProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  heightCm       Float?
  birthYear      Int?
  sex            String? // male | female
  activityFactor Float    @default(1.2) // бытовая активность поверх базового обмена
  shareBody      Boolean  @default(false) // показывать другим вес и % жира, а не только % к цели
  /// В чём человеку привычнее вводить и видеть мышцы: kg — масса (так показывают Zepp, Mi Fitness),
  /// percent — доля (так её отдаёт хранилище здоровья). Пусто — ещё не выбирал: берём единицу цели,
  /// а без цели килограммы. В WeightEntry мышцы всегда лежат в процентах.
  muscleUnit     String?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Личная цель участника в фитнес-челлендже и точка отсчёта для неё
model ParticipantGoal {
  id              Int       @id @default(autoincrement())
  participationId Int       @unique
  goalType        String // lose_weight | lose_fat | gain_muscle | custom
  targetValue     Float? // кг для lose_weight, проценты для lose_fat, у gain_muscle — по muscleUnit
  startWeightKg   Float?
  startBodyFat    Float?
  startMuscle     Float?
  /// Единица startMuscle и, у цели gain_muscle, targetValue: percent | kg. Фиксируется в цели:
  /// цель «62 кг мышц» нельзя пересчитать в проценты — для этого пришлось бы угадать будущий вес.
  /// Дефолт percent — так заданы цели, созданные до появления килограммов.
  muscleUnit      String    @default("percent")
  startDay        DateTime? @db.Date
  dailyKcalTarget Int? // необязательная личная дневная цель по калориям
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
}

// Обхваты и прочие замеры сантиметровой лентой: одно значение вида на день
model BodyMeasurement {
  id        Int      @id @default(autoincrement())
  userId    Int
  day       DateTime @db.Date
  kind      String // waist | chest | hips | thigh | biceps | neck
  value     Float // сантиметры
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, kind])
}

// Журнал выгрузок с телефона: что приёмник получил от хаба в последние разы. Нужен, чтобы
// разобраться, почему у человека не появляются тренировки или вес, не читая логи контейнера
// (они живут только до следующего деплоя). Храним последние выгрузки по каждому хабу.
model IngestLog {
  id       Int      @id @default(autoincrement())
  userId   Int
  provider String // hae | health_connect
  at       DateTime @default(now())
  status   String // ok | bad_payload
  /// Размер тела запроса: по нему видно, шлёт ли телефон вообще что-нибудь
  bytes    Int      @default(0)

  workouts            Int @default(0) // в запросе
  workoutsCreated     Int @default(0)
  workoutsUpdated     Int @default(0)
  workoutsDeleted     Int @default(0) // помечено удалёнными по просьбе отправителя
  measurements        Int @default(0) // взвешиваний в запросе
  measurementsCreated Int @default(0)
  measurementsUpdated Int @default(0)

  /// Что лежало в теле: имена метрик и длины массивов. По ним видно, включены ли в приложении
  /// нужные галочки, — сами данные не храним
  summary Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, at])
}

// Тренировка. Принадлежит пользователю, а не участию: одна и та же пробежка идёт в зачёт
// любого челленджа, где он состоит. Зачёт недели считается на лету по startedAt.
model Workout {
  id            Int       @id @default(autoincrement())
  userId        Int
  source        String // manual | whoop | hae | health_connect | strava
  /// Идентификатор во внешней системе; у ручной записи — UUID с клиента. Обязателен:
  /// вместе с source даёт идемпотентность и при ретрае вебхука, и при двойном тапе.
  externalId    String
  startedAt     DateTime
  endedAt       DateTime?
  durationSec   Int
  tzOffsetMin   Int? // смещение пояса, в котором шла тренировка, — для показа времени
  sport         String // нормализованный ключ: run, strength, cycling…
  sportRaw      String? // как назвал источник
  kcal          Int?
  avgHr         Int?
  maxHr         Int?
  distanceM     Int?
  strain        Float?
  scoreState    String?
  note          String?
  /// Та же тренировка, пришедшая из другого источника: в зачёт и суммы ккал не идёт
  duplicateOfId Int?
  excluded      Boolean   @default(false) // снята админом
  excludedNote  String?
  /// Засчитана админом вручную: минимальная длительность и лимит дня на неё не действуют
  forceCounted  Boolean   @default(false)
  forceNote     String?
  /// Удалена пользователем. Строка остаётся, чтобы повторная синхронизация её не воскресила
  deletedAt     DateTime?
  raw           Json? // урезанный исходник без массивов — для отладки парсеров
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, startedAt])
}

// Итог недели участника — снимок на момент закрытия. Жизни нигде не хранятся: они
// выводятся прогоном этих строк по порядку (как заморозки — из истории серий).
model WeekResult {
  id              Int       @id @default(autoincrement())
  challengeId     Int
  participationId Int
  weekIndex       Int // с нуля
  weekStart       DateTime  @db.Date // границы окна участника: вступивший посреди недели
  weekEnd         DateTime  @db.Date // отвечает только за остаток
  required        Int
  done            Int
  passed          Boolean
  forgiven        Boolean   @default(false) // админ простил: жизнь не снимается
  forgivenNote    String?
  forgivenAt      DateTime?
  upgradedAt      DateTime? // провал исправлен опоздавшей синхронизацией
  notifiedAt      DateTime? // участнику написали в ЛС
  closedAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  challenge     Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, weekIndex])
  @@index([challengeId, weekIndex])
}

// Подключённый источник тренировок: один на пользователя и провайдера.
// Облачные провайдеры (WHOOP) живут на OAuth-токенах, телефонные хабы (Health Auto Export,
// Health Connect) — на личном ingestToken, как умные весы.
model Integration {
  id              Int       @id @default(autoincrement())
  userId          Int
  provider        String // whoop | hae | health_connect | strava
  status          String    @default("active") // active | reauth_required | disabled
  /// Секрет для push-приёмника хаба. Уникален: по нему находим владельца запроса.
  ingestToken     String?   @unique
  /// OAuth-токены лежат зашифрованными (AES-256-GCM, ключ TOKEN_ENC_KEY): утечка дампа
  /// базы не должна отдавать доступ к чужим браслетам.
  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?
  scope           String?
  /// Идентификатор пользователя у провайдера: вебхук WHOOP присылает именно его
  externalUserId  String?
  lastSyncAt      DateTime?
  lastEventAt     DateTime?
  backfilledAt    DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, externalUserId])
}

// Справочник продуктов: пищевая ценность на 100 г. Общий для всех: базовый набор приходит
// сидом, «свои» продукты участники добавляют сами, найденное в Open Food Facts кэшируется.
model FoodProduct {
  id              Int      @id @default(autoincrement())
  source          String // seed | custom | off
  /// seed: слаг; off: штрихкод; custom: случайный id. Вместе с source — ключ для upsert сида
  externalId      String
  name            String
  /// Имя для поиска: нижний регистр, «ё» → «е»
  nameLc          String
  brand           String?
  kcal100         Float
  protein100      Float?
  fat100          Float?
  carbs100        Float?
  /// Типичная порция, если у продукта она есть: «1 шт.» = 55 г для яйца
  servingGrams    Float?
  servingLabel    String?
  createdByUserId Int?
  isHidden        Boolean  @default(false)
  createdAt       DateTime @default(now())

  entries FoodEntry[]

  @@unique([source, externalId])
  @@index([nameLc])
}

// Запись дневника питания. Либо просто число калорий, либо продукт с граммовкой —
// тогда калории и БЖУ посчитаны при записи и от правок справочника потом не зависят.
model FoodEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  /// Логический день с клиента: ночной перекус в 00:30 человек сам относит к нужному дню
  day       DateTime @db.Date
  eatenAt   DateTime @default(now())
  meal      String? // breakfast | lunch | dinner | snack
  title     String
  kcal      Int
  protein   Float?
  fat       Float?
  carbs     Float?
  grams     Float?
  productId Int?
  /// Идентификатор формы: повторная отправка не создаёт вторую запись
  clientId  String
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product FoodProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([userId, day])
}
