generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователь Telegram
model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  username   String?
  firstName  String?
  lastName   String?
  photoUrl   String?
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())
  /// Секрет для вебхука умных весов (openScale sync). null — весы не подключены.
  scaleToken String?  @unique

  participations     Participation[]
  personalChallenges PersonalChallenge[]
  weights            WeightEntry[]
  scaleProfiles      ScaleProfile[]      @relation("ScaleProfileOwner")
  scaleProfilesTaken ScaleProfile[]      @relation("ScaleProfileTarget")
}

// Челлендж (например «Планка каждый день»). Все настройки редактируются в админке.
model Challenge {
  id                 Int      @id @default(autoincrement())
  key                String   @unique
  /// plank — ежедневная планка с кружками и штрафами; weight — группа для взвешиваний
  kind               String   @default("plank")
  title              String
  description        String   @default("")
  rulesText          String   @default("")
  isActive           Boolean  @default(true)
  timezone           String   @default("Europe/Moscow")
  startDate          DateTime @db.Date
  dailyDeadline      String   @default("23:59") // HH:mm в TZ челленджа
  sickDeadline       String   @default("14:00") // HH:mm в TZ челленджа
  minDurationSec     Int      @default(60)
  fineAmount         Int      @default(500)
  fakeFineMultiplier Int      @default(2)
  chatId             BigInt? // мониторимая группа
  freezeStreakOnSick Boolean  @default(true)
  freezeEveryDays    Int      @default(30) // сколько дней подряд даёт одну заморозку серии (0 = выключено)
  maxFreezes         Int      @default(3) // сколько заморозок можно держать на руках (0 = выключено)
  reportTime         String   @default("00:05") // когда слать отчёт за предыдущий день
  reminderTime       String   @default("21:00") // когда напоминать тем, кто не прислал кружок
  dmReminders        Boolean  @default(true) // слать личные напоминания в ЛС (помимо чата)
  lastChanceTime     String   @default("23:30") // «последний шанс» в ЛС перед дедлайном (пусто = выкл)
  createdAt          DateTime @default(now())

  participations Participation[]
  submissions    Submission[]
  sickDays       SickDay[]
  ledger         LedgerEntry[]
  quotes         MotivationalQuote[]
  reports        DailyReport[]
  freezes        StreakFreeze[]
}

// Участие пользователя в челлендже («подтверждение участия»)
model Participation {
  id          Int       @id @default(autoincrement())
  challengeId Int
  userId      Int
  status      String    @default("active") // active | left
  joinedAt    DateTime  @default(now())
  leftAt      DateTime? // когда участника исключили (null, пока он в челлендже)

  challenge         Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions       Submission[]
  sickDays          SickDay[]
  freezes           StreakFreeze[]
  ledger            LedgerEntry[]
  notificationPrefs NotificationPref[]

  @@unique([challengeId, userId])
}

// Личные настройки уведомлений участника. Пустое поле = «как у челленджа»,
// заданное — перебивает настройку админа.
model NotificationPref {
  id              Int       @id @default(autoincrement())
  participationId Int
  type            String // daily_reminder
  enabled         Boolean? // null = как у челленджа (dmReminders)
  timeHHmm        String? // HH:mm, только :00 и :30; null = как у челленджа (reminderTime)
  lastSentDay     DateTime? @db.Date // защита от повторной отправки в тот же день
  updatedAt       DateTime  @updatedAt

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, type])
}

// Подтверждение планки (видео-кружок)
model Submission {
  id              Int      @id @default(autoincrement())
  challengeId     Int
  participationId Int
  day             DateTime @db.Date // день челленджа в его TZ
  messageId       BigInt?
  videoDuration   Int?
  submittedAt     DateTime @default(now())
  status          String   @default("counted") // counted | late | fake | rejected
  createdAt       DateTime @default(now())

  challenge     Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, day])
}

// Заявка о болезни/травме
model SickDay {
  id              Int      @id @default(autoincrement())
  challengeId     Int
  participationId Int
  day             DateTime @db.Date
  reportedAt      DateTime @default(now())
  status          String   @default("valid") // valid (до дедлайна) | late
  note            String?

  challenge     Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, day])
}

// Заморозка серии: участник тратит заработанную заморозку на пропущенный день,
// чтобы серия не оборвалась. Заработанные заморозки не хранятся — они считаются
// из истории (каждые challenge.freezeEveryDays дней подряд = одна заморозка),
// в базе лежат только потраченные.
model StreakFreeze {
  id              Int      @id @default(autoincrement())
  challengeId     Int
  participationId Int
  day             DateTime @db.Date // какой день заморожен
  earnedDay       DateTime @db.Date // день, за который эта заморозка получена (раньше него применить нельзя)
  createdAt       DateTime @default(now())

  challenge     Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([participationId, day])
}

// Реестр банка: банк = SUM(amount) по типам miss|fake|adjustment|spend. amount > 0 пополняет, < 0 списывает.
// payment (оплата участника, «сколько скинул») хранится с положительной суммой, гасит личный долг, но в банк не входит.
model LedgerEntry {
  id              Int       @id @default(autoincrement())
  challengeId     Int
  participationId Int?
  type            String // miss | fake | adjustment | spend | payment
  amount          Int
  day             DateTime? @db.Date
  note            String?
  createdAt       DateTime  @default(now())

  challenge     Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participation Participation? @relation(fields: [participationId], references: [id], onDelete: SetNull)
}

// Мотивационная речь (редактируется в админке)
model MotivationalQuote {
  id          Int       @id @default(autoincrement())
  challengeId Int? // null = глобальная
  text        String
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

// Личный челлендж пользователя (например подтягивания/отжимания), только для себя
model PersonalChallenge {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  unit      String   @default("повторений")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets WorkoutSet[]
}

// Один подход в личном челлендже (день + число повторений)
model WorkoutSet {
  id                  Int      @id @default(autoincrement())
  personalChallengeId Int
  day                 DateTime @db.Date
  reps                Int
  createdAt           DateTime @default(now())

  challenge PersonalChallenge @relation(fields: [personalChallengeId], references: [id], onDelete: Cascade)

  @@index([personalChallengeId, day])
}

// Взвешивание на умных весах. Прилетает вебхуком из openScale sync (Android),
// который слушает весы по Bluetooth. Данные личные: видит только сам пользователь.
model WeightEntry {
  id            Int      @id @default(autoincrement())
  userId        Int
  measuredAt    DateTime // момент взвешивания (приходит от весов)
  day           DateTime @db.Date // день в TZ приложения
  weightKg      Float
  bodyFat       Float? // % жира
  water         Float? // % воды
  muscle        Float? // % мышц
  scaleEntryId  Int? // id записи в openScale (чтобы поймать правку уже отправленного измерения)
  scaleUserId   Int? // id пользователя в openScale (на одном телефоне их может быть несколько)
  scaleUsername String?
  sourceOwnerId Int? // чей телефон прислал запись (владелец токена), null — ручной источник
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, measuredAt])
  @@index([userId, day])
  @@index([sourceOwnerId, scaleUserId])
}

// Пользователь весов (профиль в openScale на телефоне владельца токена). Когда на одни
// весы встаёт вся семья, openScale раскладывает взвешивания по своим профилям, а владелец
// в кабинете указывает, кому из участников какой профиль принадлежит.
model ScaleProfile {
  id            Int      @id @default(autoincrement())
  ownerId       Int // чей телефон (владелец токена вебхука)
  scaleUserId   Int // id пользователя внутри openScale
  scaleUsername String? // как профиль назван в openScale — чтобы узнать его в кабинете
  targetUserId  Int? // кому писать взвешивания; null — самому владельцу
  lastSeenAt    DateTime @default(now()) // когда с этого профиля приходило последнее измерение
  createdAt     DateTime @default(now())

  owner  User  @relation("ScaleProfileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  target User? @relation("ScaleProfileTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@unique([ownerId, scaleUserId])
}

// Лог отправленных дневных отчётов (идемпотентность)
model DailyReport {
  id          Int      @id @default(autoincrement())
  challengeId Int
  day         DateTime @db.Date
  content     String
  sentAt      DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, day])
}
